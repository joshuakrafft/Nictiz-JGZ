    <element id="Observation">
      <path value="Observation"/>
      <short value="Observation"/>
      <definition value="A finding, measurement, assessment or score about the patient, or about the context of the patient, made at a point or period in time."/>
      <comment value="Three patterns are supported (Nictiz profiling guidelines §11.1.1 and §11.1.2):&#10;&#10;* **single Observation**: `code` identifies the concept, `value[x]` holds the result;&#10;* **Observation with components**: for scores, questionnaires/instruments and measurement qualifiers that cannot be interpreted on their own (e.g. SDQ, BFMT, blood pressure). The root `code` identifies the instrument or total score, each `component.code` a part;&#10;* **grouping Observation (panel)**: parts that can be interpreted on their own are separate Observations referenced from `hasMember` (e.g. Van Wiechen items).&#10;&#10;Qualifiers of a measurement are placed on `method` and `bodySite` when possible, otherwise on `component`. Free-text explanations of a result are placed on `note`."/>
      <constraint>
        <key value="obs-value-1"/>
        <requirements value="Copied from medicalTestResult-eu-core (compliesWithProfile)."/>
        <severity value="error"/>
        <human value="The elements Observation.extension:value-r5 and Observation.value[x] SHALL not be used simultaneously."/>
        <expression value="value.empty() or extension('http://hl7.org/fhir/5.0/StructureDefinition/extension-Observation.value').empty()"/>
      </constraint>
      <mapping>
        <identity value="xt-ehr-EHDSObservation"/>
        <map value="EHDSObservation"/>
      </mapping>
    </element>
