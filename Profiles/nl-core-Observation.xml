    <element id="Observation.code">
      <path value="Observation.code"/>
      <short value="Observation type"/>
      <definition value="Code identifying the kind of observation: what was observed, measured, assessed or scored."/>
      <comment value="For data from the Basisdataset JGZ, use the BDS element number (code system BDS ElementID, `urn:oid:2.16.840.1.113883.2.4.4.40.267`) or, for grouping and instrument observations without a BDS element, the BDS rubriek code (`urn:oid:2.16.840.1.113883.2.4.4.40.391`). When a LOINC or SNOMED CT code is known, it is sent as an additional `coding` with the same meaning. See the additional binding."/>
      <binding>
        <extension url="http://hl7.org/fhir/tools/StructureDefinition/additional-binding">
          <extension url="key">
            <valueId value="bds-jgz-observation-code"/>
          </extension>
          <extension url="purpose">
            <valueCode value="preferred"/>
          </extension>
          <extension url="valueSet">
            <valueCanonical value="http://nictiz.nl/fhir/ValueSet/jgz-BdsObservationCodes"/>
          </extension>
          <extension url="documentation">
            <valueMarkdown value="BDS JGZ element codes (code system *BDS ElementID*, 2.16.840.1.113883.2.4.4.40.267) and BDS rubriek codes (*BDS RubriekID*, 2.16.840.1.113883.2.4.4.40.391) that identify the kind of observation for data from the Basisdataset JGZ. This binding is additional to, and does not replace, the base binding. When a LOINC or SNOMED CT code is known for the BDS element it SHOULD be sent as an additional coding."/>
          </extension>
        </extension>
        <strength value="example"/>
        <description value="Codes identifying names of simple observations."/>
        <valueSet value="http://hl7.org/fhir/ValueSet/observation-codes"/>
      </binding>
      <mapping>
        <identity value="xt-ehr-EHDSObservation"/>
        <map value="EHDSObservation.type"/>
      </mapping>
    </element>
